#!/usr/bin/env -S python3 -I
"""gpu-run: run a command as a graphics-card job and record what happened.

  gpu-run --label "<what this is>" [--kind KIND] [--tokens N] [--cpu] [--no-lock] [--only-when-idle MIN] -- <command...>
  gpu-run --watch <seconds> [--label "<what>"]   sample the card without running anything
  gpu-run --report [--since YYYY-MM-DD]           Markdown summary of the log
  gpu-run --events [--since YYYY-MM-DD]           Windows display driver events
  gpu-run --off "<reason>" | --on                 switch GPU jobs off or on everywhere

The card has a pool of tokens, one per headless WebGL browser process that may draw at once, one
flock file each (/tmp/test-gpu-<n>.lock, n = 1 to TEST_GPU_JOBS, default 3, the same files the
party-games test helper takes). A job takes one token, or N with --tokens N (a gate that runs
several browser suites side by side), and waits while too few are free; a heavy job (--kind
blender, image or model) takes every token, so no test browser draws beside a render. Tokens are
taken all at once or not at all, under a gate file (/tmp/test-gpu-gate.lock) that lets a job
waiting for several tokens go before single-token jobs that come after it, for a few minutes at a
time (GATE_PRIORITY_S); a job that waits long says who holds the tokens.
The command gets the tokens in TEST_GPU_TOKENS, and the test helper and a gpu-run inside it draw
only on those, claiming one each, instead of taking more from the pool. They also hold the card
token themselves, so it stays taken while they run, even after gpu-run itself is killed. The
command does not inherit gpu-run's locks: a background process it leaves holds no token, and one
that does (a helper or gpu-run left running) is named loudly at the end and logged.
A job refuses to start while TEST_NO_GPU=1 is set or the OFF marker exists.

Admission: before it takes its tokens, a job waits until the card can take it: the busiest
engine averaged under 70% over the last 10 s, at least 2 GB of video memory free, the card under
80 C, and no display driver event in the last 30 minutes (ADMIT_* below). Readings come from
another running job's sampler when it has covered the window (STATE/live), so the check usually
costs nothing; otherwise from the job's own, about 10 s. It says why it waits, and after
--admit-wait seconds (default 45 minutes) it gives up with exit 6 and a log record, or with
--admit-timeout-runs (the pre-deploy gate) starts anyway with a loud line. A job inside a job
(TEST_GPU_TOKENS set) is part of an admitted job and skips it.
While it runs, one long-lived PowerShell process on the Windows side reads the GPU performance
counters every two seconds and streams them back. At the end one JSON line goes to
~/.local/state/gpu/jobs.jsonl and three summary lines are printed.

--cpu marks a CPU comparison run of the same label: it takes no lock, runs while the card is
switched off, and sets TEST_NO_GPU=1 for the command so test browsers draw in software.

Environment (mostly for tests): GPU_RUN_STATE (state folder), GPU_RUN_LOCK (slot lock files,
with {n} for the slot number),
GPU_RUN_ADAPTER (adapter name to sample, default "RX 7800"), GPU_RUN_SAMPLER, GPU_RUN_EVENTS
and GPU_RUN_IDLE (commands that replace the Windows sampler, event query and idle check),
GPU_RUN_GATE_PRIORITY_S, GPU_RUN_GATE_WAIT_MAX_S and GPU_RUN_WAIT_REPORT_S (the gate's limits).
--only-when-idle MIN refuses unless nobody has touched the PC for MIN minutes and no full-screen
program has the screen (Windows GetLastInputInfo and SHQueryUserNotificationState).
--max-temp C (above 0, at most 110) refuses while the card is hotter than C degrees or its
temperature cannot be read, and stops the job (SIGTERM to the command and everything it started,
SIGKILL after five seconds) when three readings in a row (about six seconds) are above C; the
record then has stopped_for_heat and heat_peak_c. A reading missing mid-job does not stop it and is
counted in temp_readings_missing. The sampler also reads the card's
temperature and fan speed (as Task Manager does), so every record has temp_c_start, temp_c_peak,
temp_c_end and fan_rpm_peak, and a --watch record has every reading (temp_c_trace) to show how
fast the card cools down.

When a display driver event falls inside a job's own time window, gpu-run writes the OFF marker
(as --off does) naming the event, so the next job refuses until `gpu-run --on`. An existing marker
is left as it is.

Exit codes: the command's own, 3 when the card is switched off, 4 when the PC is not idle,
5 when the card is too hot (--max-temp, at the start or during the job), 6 when the card did not
settle for admission within --admit-wait, 2 for usage errors.
"""

import argparse
import base64
import ctypes
import fcntl
import json
import math
import os
import resource
import shlex
import shutil
import signal
import statistics
import subprocess
import sys
import threading
import time
from datetime import datetime, timedelta

HOME = os.path.expanduser("~")
STATE = os.environ.get("GPU_RUN_STATE") or os.path.join(HOME, ".local/state/gpu")
LOG = os.path.join(STATE, "jobs.jsonl")
OFF = os.path.join(STATE, "OFF")
LOCK = os.environ.get("GPU_RUN_LOCK") or "/tmp/test-gpu-{n}.lock"
# The card's token pool: one token per headless WebGL browser process that may draw at once,
# unless TEST_GPU_JOBS says otherwise. Real suites ran fine to about six browsers at once and
# failed from eight (GPU-PLAYBOOK.md, "How many jobs at once"); the pool starts at 3 and the owner
# ramps it (3, 4, 5) with TEST_GPU_JOBS. The party-games test helper (lobby/test/browser.mjs,
# DEFAULT_CARD_SLOTS) uses the same number: keep them in step.
DEFAULT_SLOTS = 3
HEAVY = {"blender", "image", "model"}  # these take every token
# Tokens an ancestor holds for this process tree (paths, separated by ":"). A process that has
# them takes nothing from the pool: it claims some of them instead (see Pool.inherited).
TOKENS_ENV = "TEST_GPU_TOKENS"


def env_seconds(name, default):
    """A time limit, overridable by the environment (for tests)."""
    try:
        return max(0.0, float(os.environ.get(name) or default))
    except ValueError:
        return default


# Waiting for tokens. A job first in line holds the gate for at most GATE_PRIORITY_S, then lets it
# go for GATE_YIELD_S so jobs that need fewer tokens can start beside a long holder; a gate held
# past GATE_WAIT_MAX_S is passed by. A waiting job names the holders after WAIT_REPORT_S, then
# every WAIT_REPORT_EVERY_S.
GATE_PRIORITY_S = env_seconds("GPU_RUN_GATE_PRIORITY_S", 180)
GATE_YIELD_S = 5.0
GATE_WAIT_MAX_S = env_seconds("GPU_RUN_GATE_WAIT_MAX_S", 600)
WAIT_REPORT_S = env_seconds("GPU_RUN_WAIT_REPORT_S", 60)
WAIT_REPORT_EVERY_S = 300
# Admission: before a job takes its tokens, the card must look able to take it. Load is the
# busiest 3D, compute or copy engine (as the sampler reports it), averaged over the last
# ADMIT_WINDOW_S. Every sampler writes its recent readings to STATE/live/<pid>.json, so a job that
# starts while another job's sampler has been running for the whole window decides at once.
ADMIT_WINDOW_S = 10
ADMIT_MAX_LOAD = 70.0  # percent
ADMIT_MIN_FREE_GB = 2.0  # free video memory
ADMIT_MAX_TEMP = 80.0  # degrees C
ADMIT_EVENT_MINUTES = 30  # no display driver event in this many minutes before the start
# Windows files the report of a driver timeout more than once, the processed one (with a fault
# bucket, "LKD_...") up to half an hour after the first. A processed report counts from the first
# report before it within this many minutes, not from its own time.
ADMIT_EVENT_REPORT_LAG_MINUTES = 60
ADMIT_MAX_WAIT_S = 45 * 60  # comfortably longer than the event window; then exit 6, or with
#                             --admit-timeout-runs the job starts anyway, with a loud line
ADMIT_EVENT_RECHECK_S = 60  # how often the event log is asked again while a job waits
LIVE = os.path.join(STATE, "live")  # recent samples of every running sampler, for admission
LIVE_FUTURE_SLACK_S = 5  # a published reading dated further ahead than this is ignored
ADAPTER = os.environ.get("GPU_RUN_ADAPTER") or "RX 7800"
INTERVAL = 2.0
HOT_READINGS = 3  # readings in a row above --max-temp that stop a job (one spike does not)
STOP_GRACE = 5.0  # seconds between SIGTERM and SIGKILL when a job is stopped
MAX_TEMP_LIMIT = 110  # the highest --max-temp that makes sense for a graphics card
KINDS = ["browser-test", "blender", "image", "model", "other"]
GB = 1024**3

# The sampler runs on Windows. It reads whole counter categories at once
# (PerformanceCounterCategory.ReadCategory: about 2 ms after a first read of about 5 s),
# because Get-Counter takes seconds per call with several hundred GPU engine instances.
# The adapter is picked by name from the DirectX registry keys, which hold each adapter's
# LUID, the id the counter instance names carry. Load is the busiest 3D, compute or copy engine
# (each engine summed over processes, as Task Manager does), leaving out the video encode and
# decode engines, which are separate units: AMD's recording service can keep one busy all day
# without slowing a render. Every engine type's peak is still logged. It writes one JSON line per sample and stops
# when its output pipe closes (gpu-run ended), or after the deadline.
SAMPLER_PS = r"""
$ErrorActionPreference = 'Stop'
$match = '__MATCH__'; $interval = __INTERVAL__; $deadline = (Get-Date).AddSeconds(__MAXSEC__)
$out = [Console]::Out
function Emit($o) { $out.WriteLine(($o | ConvertTo-Json -Compress -Depth 4)); $out.Flush() }
try {
  $memCat = New-Object Diagnostics.PerformanceCounterCategory 'GPU Adapter Memory'
  $engCat = New-Object Diagnostics.PerformanceCounterCategory 'GPU Engine'
  $pmCat = New-Object Diagnostics.PerformanceCounterCategory 'GPU Process Memory'
  $mem = $memCat.ReadCategory()['Dedicated Usage']
  $pick = $null
  foreach ($k in Get-ChildItem 'HKLM:\SOFTWARE\Microsoft\DirectX') {
    $p = Get-ItemProperty $k.PSPath
    if (-not $p.Description -or -not $p.AdapterLuid -or $p.Description -notlike "*$match*") { continue }
    $l = [int64]$p.AdapterLuid
    $luid = 'luid_0x{0:x8}_0x{1:x8}_' -f ($l -shr 32), ($l -band 0xffffffffL)
    if (@($mem.Keys | Where-Object { $_.StartsWith($luid) }).Count -gt 0) {
      $pick = @{ name = ($p.Description -replace '\s+', ' ').Trim(); luid = $luid; luidValue = $l; total = [int64]$p.DedicatedVideoMemory }
      break
    }
  }
  if (-not $pick) { Emit @{ error = "no adapter named *$match* in the GPU counters" }; exit 2 }
  $luid = $pick.luid
  # Temperature and fan speed, read the way Task Manager does: D3DKMTQueryAdapterInfo with
  # KMTQAITYPE_ADAPTERPERFDATA (62) on the adapter whose LUID is the one picked above. The handle
  # is opened once; each sample is one call (microseconds). Power is left out: this driver
  # reports 0. Any failure here only drops the temperature, never the other figures.
  $thermal = $false
  try {
    Add-Type -TypeDefinition @'
using System; using System.Runtime.InteropServices;
public static class GpuRunKmt {
  [StructLayout(LayoutKind.Sequential)] struct LUID { public uint Low; public int High; }
  [StructLayout(LayoutKind.Sequential)] struct INFO { public uint h; public LUID Luid; public uint Sources; public int Move; }
  [StructLayout(LayoutKind.Sequential)] struct ENUM2 { public uint Num; public IntPtr p; }
  [StructLayout(LayoutKind.Sequential)] struct QUERY { public uint h; public int Type; public IntPtr p; public uint Size; }
  [StructLayout(LayoutKind.Sequential)] struct CLOSE { public uint h; }
  [StructLayout(LayoutKind.Sequential)] public struct PERF {
    public uint PhysicalAdapterIndex; public ulong MemoryFrequency; public ulong MaxMemoryFrequency; public ulong MaxMemoryFrequencyOC;
    public ulong MemoryBandwidth; public ulong PCIEBandwidth; public uint FanRPM; public uint Power; public uint Temperature; public byte PowerStateOverride;
  }
  [DllImport("gdi32.dll")] static extern int D3DKMTEnumAdapters2(ref ENUM2 e);
  [DllImport("gdi32.dll")] static extern int D3DKMTQueryAdapterInfo(ref QUERY q);
  [DllImport("gdi32.dll")] static extern int D3DKMTCloseAdapter(ref CLOSE c);
  static uint handle; static IntPtr buf = IntPtr.Zero;
  // Opens the adapter with this LUID and closes every other handle; false if there is none.
  public static bool Open(long luid) {
    var e = new ENUM2(); D3DKMTEnumAdapters2(ref e);
    if (e.Num == 0) return false;
    int sz = Marshal.SizeOf(typeof(INFO));
    e.p = Marshal.AllocHGlobal(sz * (int)e.Num);
    try {
      if (D3DKMTEnumAdapters2(ref e) != 0) return false;
      bool found = false;
      for (int i = 0; i < (int)e.Num; i++) {
        var a = (INFO)Marshal.PtrToStructure(new IntPtr(e.p.ToInt64() + i * sz), typeof(INFO));
        long l = ((long)a.Luid.High << 32) | a.Luid.Low;
        if (!found && l == luid) { handle = a.h; found = true; continue; }
        var c = new CLOSE(); c.h = a.h; D3DKMTCloseAdapter(ref c);
      }
      if (found) buf = Marshal.AllocHGlobal(Marshal.SizeOf(typeof(PERF)));
      return found;
    } finally { Marshal.FreeHGlobal(e.p); }
  }
  // { temperature in tenths of a degree C, fan rpm }, or null when the query fails.
  public static uint[] Read() {
    int n = Marshal.SizeOf(typeof(PERF));
    for (int b = 0; b < n; b++) Marshal.WriteByte(buf, b, 0);
    var q = new QUERY(); q.h = handle; q.Type = 62; q.p = buf; q.Size = (uint)n;
    if (D3DKMTQueryAdapterInfo(ref q) != 0) return null;
    var p = (PERF)Marshal.PtrToStructure(buf, typeof(PERF));
    return new uint[] { p.Temperature, p.FanRPM };
  }
}
'@
    $thermal = [GpuRunKmt]::Open($pick.luidValue)
  } catch { $thermal = $false }
  $names = @{}; $prev = @{}; $n = 0
  $self = [Diagnostics.Process]::GetCurrentProcess()
  while ((Get-Date) -lt $deadline) {
    $t0 = [Environment]::TickCount
    $eng = $engCat.ReadCategory()['Utilization Percentage']
    $cur = @{}; $sum = @{}; $types = @{}
    foreach ($k in $eng.Keys) {
      if (-not $k.Contains($luid)) { continue }
      $s = $eng[$k].Sample; $cur[$k] = $s
      if ($prev.ContainsKey($k)) {
        $v = [Diagnostics.CounterSample]::Calculate($prev[$k], $s)
        # Every WSL process shows up under the VM's one Windows process (vmwp), so their
        # instance names collide and Windows numbers the copies ("...engtype_3D#2"): strip that
        # too, or two WSL jobs on the same engine read as two half-busy engines.
        $e = ($k -replace '^pid_\d+_', '') -replace '#\d+$', ''
        $sum[$e] = [double]$sum[$e] + $v
      }
    }
    $load = $null
    if ($prev.Count -gt 0) {
      $load = 0.0
      foreach ($e in $sum.Keys) {
        $v = [Math]::Min(100.0, $sum[$e]); $ty = ($e -split 'engtype_')[1]
        if ($ty -notmatch 'video' -and $v -gt $load) { $load = $v }
        if ($v -gt [double]$types[$ty]) { $types[$ty] = [Math]::Round($v, 1) }
      }
      $load = [Math]::Round($load, 1)
    }
    $prev = $cur
    $used = [int64]0
    $mem = $memCat.ReadCategory()['Dedicated Usage']
    foreach ($k in $mem.Keys) { if ($k.StartsWith($luid)) { $used += $mem[$k].RawValue } }
    $byPid = @{}
    $pm = $pmCat.ReadCategory()['Dedicated Usage']
    foreach ($k in $pm.Keys) {
      if (-not $k.Contains($luid)) { continue }
      $id = [int]($k -replace '^pid_(\d+)_.*$', '$1')
      $byPid[$id] = [int64]$byPid[$id] + [int64]$pm[$k].RawValue  # vmwp has one instance per WSL process
    }
    $procs = @($byPid.Keys | Where-Object { $byPid[$_] -ge 1MB } | ForEach-Object { [pscustomobject]@{ id = $_; b = $byPid[$_] } })
    if ($n % 30 -eq 0) { $names = @{} }
    $top = @()
    foreach ($q in ($procs | Sort-Object b -Descending | Select-Object -First 5)) {
      if (-not $names.ContainsKey($q.id)) {
        try { $names[$q.id] = [Diagnostics.Process]::GetProcessById($q.id).ProcessName } catch { $names[$q.id] = '?' }
      }
      $top += ,@($names[$q.id], $q.b)
    }
    $self.Refresh()
    $o = @{ t = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() / 1000.0; load = $load; types = $types; used = $used; top = $top; cpu = [Math]::Round($self.TotalProcessorTime.TotalSeconds, 2) }
    if ($thermal) {
      try { $th = [GpuRunKmt]::Read() } catch { $th = $null }
      if ($th -and $th[0] -gt 0) { $o.temp = [Math]::Round($th[0] / 10.0, 1); $o.fan = [int]$th[1] }
    }
    if ($n -eq 0) { $o.adapter = $pick.name; $o.total = $pick.total }
    Emit $o
    $n++
    $wait = $interval - ([Environment]::TickCount - $t0)
    if ($wait -gt 0) { Start-Sleep -Milliseconds $wait }
  }
} catch { exit 0 }
"""

# Display driver trouble in the Windows logs. On this kind of machine an AMD driver timeout
# (TDR) shows up as Windows Error Reporting event 1001 "LiveKernelEvent" with code 141 (bucket
# LKD_0x141_Tdr..._IMAGE_amdkmdag.sys) in the Application log, not as the classic System
# "Display" 4101. Both are queried, plus application crashes in a graphics module and anything
# from the AMD kernel drivers or AMD's crash service.
EVENTS_PS = r"""
$ErrorActionPreference = 'SilentlyContinue'
$s = [DateTimeOffset]::FromUnixTimeSeconds(__START__).LocalDateTime
$e = [DateTimeOffset]::FromUnixTimeSeconds(__END__).LocalDateTime
$found = @()
$found += Get-WinEvent -FilterHashtable @{ LogName = 'System'; StartTime = $s; EndTime = $e; ProviderName = 'Display', 'amdkmdag', 'amdwddmg', 'AMD Crash Defender Service' }
$found += Get-WinEvent -FilterHashtable @{ LogName = 'Application'; StartTime = $s; EndTime = $e; ProviderName = 'Windows Error Reporting'; Id = 1001 } |
  Where-Object { $_.Message -match 'LiveKernelEvent' -and $_.Message -match 'P1: (141|117|1a1|1a8)\b|Tdr|amdkmdag' }
$found += Get-WinEvent -FilterHashtable @{ LogName = 'Application'; StartTime = $s; EndTime = $e; ProviderName = 'Application Error'; Id = 1000 } |
  Where-Object { $_.Message -match 'amd|atig|atiu|d3d|dxgi|vulkan|opengl|igd' }
$rows = @($found | Where-Object { $_ } | Sort-Object TimeCreated | ForEach-Object {
  $m = ($_.Message -replace '\s+', ' ')
  if ($env:USERPROFILE) { $m = $m.Replace($env:USERPROFILE, '%USERPROFILE%') }
  if ($env:COMPUTERNAME) { $m = $m.Replace($env:COMPUTERNAME, '%COMPUTERNAME%') }
  @{ time = $_.TimeCreated.ToString('yyyy-MM-ddTHH:mm:sszzz'); log = $_.LogName; provider = $_.ProviderName; id = $_.Id; text = $m.Substring(0, [Math]::Min(160, $m.Length)) }
})
ConvertTo-Json -Compress -Depth 3 -InputObject $rows
"""

# Minutes since the last keyboard or mouse input in the owner's Windows session, and the shell's
# notification state, which says when a full-screen program (a game, a presentation) has the
# screen. Borderless-window games may not count as full screen.
IDLE_PS = r"""
Add-Type @'
using System; using System.Runtime.InteropServices;
public static class GpuRunIdle {
  [StructLayout(LayoutKind.Sequential)] struct LII { public uint cbSize; public uint dwTime; }
  [DllImport("user32.dll")] static extern bool GetLastInputInfo(ref LII p);
  [DllImport("shell32.dll")] public static extern int SHQueryUserNotificationState(out int s);
  public static double Minutes() { var l = new LII(); l.cbSize = (uint)Marshal.SizeOf(l); GetLastInputInfo(ref l); return unchecked((uint)Environment.TickCount - l.dwTime) / 60000.0; }
}
'@
$st = 0; [void][GpuRunIdle]::SHQueryUserNotificationState([ref]$st)
ConvertTo-Json -Compress -InputObject @{ idle_min = [Math]::Round([GpuRunIdle]::Minutes(), 1); state = $st }
"""
FULLSCREEN = {2: "a full-screen program", 3: "a full-screen Direct3D game", 4: "presentation mode", 7: "a full-screen app"}


def powershell():
    return shutil.which("powershell.exe") or next(
        (p for p in ["/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"] if os.path.exists(p)), None)


def ps_command(script):
    exe = powershell()
    if not exe:
        return None
    enc = base64.b64encode(script.encode("utf-16-le")).decode()
    return [exe, "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-EncodedCommand", enc]


def short(text):
    return text.replace(HOME, "~") if HOME and HOME != "/" else text


def now_iso(ts=None):
    return datetime.fromtimestamp(ts if ts is not None else time.time()).astimezone().isoformat(timespec="seconds")


def loadavg():
    try:
        return [round(x, 2) for x in os.getloadavg()]
    except OSError:
        return None


# ---------- sampler ----------

class Sampler:
    """Starts the sampler, collects its lines in a thread, and summarises them."""

    def __init__(self, max_seconds):
        fake = os.environ.get("GPU_RUN_SAMPLER")
        if fake:
            cmd = shlex.split(fake)
        else:
            script = (SAMPLER_PS.replace("__MATCH__", ADAPTER.replace("'", "''"))
                      .replace("__INTERVAL__", str(int(INTERVAL * 1000)))
                      .replace("__MAXSEC__", str(int(max_seconds))))
            cmd = ps_command(script)
        self.samples, self.error, self.proc, self.stopping = [], None, None, False
        self.ready = threading.Event()
        if not cmd:
            self.error = "no powershell.exe (not on WSL?)"
            self.ready.set()
            return
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, text=True, cwd="/")
        except OSError as e:
            self.error = f"sampler did not start: {e}"
            self.ready.set()
            return
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        try:
            for line in self.proc.stdout:
                if self.stopping:
                    break
                try:
                    s = json.loads(line)
                except ValueError:
                    continue
                if "error" in s:
                    self.error = s["error"]
                    break
                s["at"] = time.time()  # when it arrived, on this machine's clock
                self.samples.append(s)
                self._publish()
                self.ready.set()
        except (ValueError, OSError):  # stop() closed the pipe under us
            pass
        self.ready.set()

    def _publish(self):
        """Writes the readings of the last admission window (and a little more) to
        STATE/live/<pid>.json, for other jobs' admission (shared_readings)."""
        total = self.samples[0].get("total")
        keep_from = time.time() - ADMIT_WINDOW_S - 2 * INTERVAL
        recent = [{"at": s["at"], "load": s.get("load"), "used": s.get("used"), "temp": s.get("temp")}
                  for s in self.samples[-500:] if s["at"] >= keep_from]
        try:
            os.makedirs(LIVE, exist_ok=True)
            path = os.path.join(LIVE, f"{os.getpid()}.json")
            with open(path + ".tmp", "w") as f:
                json.dump({"since": self.samples[0]["at"], "total": total, "samples": recent}, f)
            os.replace(path + ".tmp", path)
        except OSError:
            pass

    def wait_ready(self, timeout=30):
        if not self.ready.wait(timeout):
            self.error = self.error or "sampler gave no sample in 30 s"

    def stop(self):
        self.stopping = True
        # Ending the WSL side ends the Windows process too (checked). If gpu-run itself is
        # killed, the pipe closes, the next write fails and the sampler exits the same way.
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=INTERVAL * 3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()

    def latest_temp(self):
        return next((s["temp"] for s in reversed(self.samples) if s.get("temp") is not None), None)

    def summary(self, first_index=0, trace=False):
        """Card figures from samples[first_index:]; the sample before it gives 'free before' and
        the starting temperature. trace=True adds every temperature reading (for --watch, to see
        how fast the card cools down)."""
        if not self.samples:
            return {"error": self.error or "no samples"}
        head = self.samples[0]
        total = head.get("total") or 0
        before = self.samples[max(0, first_index - 1)]
        run = self.samples[first_index:] or self.samples[-1:]
        loads = [s["load"] for s in run if s.get("load") is not None]
        types = {}
        for s in run:
            for k, v in (s.get("types") or {}).items():
                types[k] = max(types.get(k, 0), v)
        peak_vram = max(s.get("used", 0) for s in run)
        top = {}
        for s in run:
            for name, b in s.get("top") or []:
                top[name] = max(top.get(name, 0), b)
        out = {
            "adapter": head.get("adapter"),
            "samples": len(run),
            "load_peak": max(loads) if loads else None,
            "load_avg": round(statistics.fmean(loads), 1) if loads else None,
            "engines_peak": dict(sorted(types.items(), key=lambda kv: -kv[1])[:4]),
            "vram_total_gb": round(total / GB, 2) if total else None,
            "vram_free_before_gb": round((total - before.get("used", 0)) / GB, 2) if total else None,
            "vram_used_peak_gb": round(peak_vram / GB, 2),
            "top_vram_gb": [[n, round(b / GB, 2)] for n, b in sorted(top.items(), key=lambda kv: -kv[1])[:5]],
            "sampler_cpu_s": round(run[-1].get("cpu", 0) - head.get("cpu", 0), 2),
        }
        temps = [s["temp"] for s in run if s.get("temp") is not None]
        fans = [s["fan"] for s in run if s.get("fan") is not None]
        if temps:
            out["temp_c_start"] = before.get("temp", temps[0])
            out["temp_c_peak"] = max(temps)
            out["temp_c_end"] = temps[-1]
        if fans:
            out["fan_rpm_peak"] = max(fans)
        if trace and temps:
            t0 = run[0].get("t", 0)
            out["temp_c_trace"] = [[round(s.get("t", 0) - t0), s["temp"]] for s in run if s.get("temp") is not None]
        if self.error:
            out["error"] = self.error
        return out


def driver_events(start, end):
    fake = os.environ.get("GPU_RUN_EVENTS")
    if fake:
        cmd = shlex.split(fake) + [str(int(start)), str(int(end))]
    else:
        cmd = ps_command(EVENTS_PS.replace("__START__", str(int(start))).replace("__END__", str(int(end) + 1)))
    if not cmd:
        return None
    try:
        out = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60, cwd="/").stdout
        rows = json.loads(out.strip() or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    if isinstance(rows, dict):  # PowerShell 5 unwraps a one-item array
        rows = [rows]
    return rows


def idle_state():
    """(minutes idle, notification state) or None when it cannot be read."""
    fake = os.environ.get("GPU_RUN_IDLE")
    cmd = shlex.split(fake) if fake else ps_command(IDLE_PS)
    if not cmd:
        return None
    try:
        d = json.loads(subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                      timeout=60, cwd="/").stdout.strip())
        return float(d["idle_min"]), int(d["state"])
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        return None


def not_idle_reason(minutes):
    st = idle_state()
    if st is None:
        return "could not read the Windows idle time"
    idle, state = st
    if state in FULLSCREEN:
        return f"{FULLSCREEN[state]} has the screen"
    if idle < minutes:
        return f"the owner used the PC {idle:g} minutes ago (wanted {minutes:g} idle)"
    return None


# ---------- off switch and lock ----------

def off_reason():
    if os.environ.get("TEST_NO_GPU") == "1":
        return "TEST_NO_GPU=1 is set"
    if os.path.exists(OFF):
        try:
            with open(OFF) as f:
                text = f.read().strip()
        except OSError:
            text = ""
        return f"the card is switched off ({short(OFF)}): {text or 'no reason given'}; `gpu-run --on` switches it back on"
    return None


def card_slots():
    try:
        return max(1, int(os.environ.get("TEST_GPU_JOBS") or DEFAULT_SLOTS))
    except ValueError:
        return DEFAULT_SLOTS


def slot_path(n):
    return LOCK.replace("{n}", str(n)) if "{n}" in LOCK else (LOCK if n == 1 else f"{LOCK}.{n}")


def open_lock(path):
    return os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o666)


def try_flock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def try_shared(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def root_token(path):
    """The card's own token a claim file stands for: the path without its ".use" endings."""
    while path.endswith(".use"):
        path = path[:-4]
    return path


def write_owner(fd, label):
    """Writes who holds a lock into its file, for waiters to name (holder_text)."""
    try:
        os.ftruncate(fd, 0)
        os.pwrite(fd, f"pid={os.getpid()} since={int(time.time())} what=gpu-run \"{label}\"\n".encode(), 0)
    except OSError:
        pass


def holder_text(path):
    """Who holds `path`, as its holder wrote it, or None when nothing says (an older gpu-run or
    test helper, or a holder that has gone)."""
    try:
        with open(path) as f:
            d = dict(kv.split("=", 1) for kv in f.read().strip().split(" ", 2) if "=" in kv)
        pid, since = int(d["pid"]), int(d["since"])
        os.kill(pid, 0)
    except (OSError, ValueError, KeyError):
        return None
    return f"{d.get('what', '?')} (pid {pid}) for {ago(since)}"


def ago(since):
    secs = time.time() - since
    return f"{secs / 60:.0f} min" if secs >= 60 else f"{secs:.0f} s"


def flock_on(line, st):
    """Whether a /proc/locks or fdinfo "lock:" line is a held flock on the file `st` describes."""
    parts = line.split()
    if "->" in parts or "FLOCK" not in parts:  # "->": waiting, not holding
        return False
    try:
        i = parts.index("FLOCK")
        major, minor, ino = parts[i + 4].split(":")
        return (int(ino) == st.st_ino and int(major, 16) == os.major(st.st_dev)
                and int(minor, 16) == os.minor(st.st_dev))
    except (ValueError, IndexError):
        return False


def lock_holders(path):
    """The live processes holding a flock on `path` (whoever they are, whatever they wrote),
    leaving out this process.

    A flock belongs to an open file, not to a process: the test helper takes its locks with the
    flock utility on a descriptor its shell then hands to `cat`, so /proc/locks names the flock
    process, which has already exited. The holders are found instead through the descriptors that
    still have the file open (/proc/<pid>/fd), whose fdinfo lists the lock; /proc/locks is the
    fallback for processes whose descriptors cannot be read."""
    try:
        st = os.stat(path)
    except OSError:
        return []
    out, me = [], os.getpid()
    for d in os.listdir("/proc"):
        if not d.isdigit() or int(d) == me:
            continue
        try:
            fds = os.listdir(f"/proc/{d}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                fst = os.stat(f"/proc/{d}/fd/{fd}")
                if (fst.st_ino, fst.st_dev) != (st.st_ino, st.st_dev):
                    continue
                with open(f"/proc/{d}/fdinfo/{fd}") as f:
                    if any(line.startswith("lock:") and flock_on(line, st) for line in f):
                        out.append(int(d))
                        break
            except OSError:
                continue
    try:
        with open("/proc/locks") as f:
            for line in f:
                if flock_on(line, st):
                    pid = int(line.split()[line.split().index("FLOCK") + 3])
                    if pid not in out and pid != me and os.path.exists(f"/proc/{pid}"):
                        out.append(pid)
    except (OSError, ValueError, IndexError):
        pass
    return out


def describe_pid(pid):
    """A process for a person: its command line (a lock-holding `cat` or `flock` stands for the
    process that started it) and how long it has run."""
    def cmdline(p):
        try:
            with open(f"/proc/{p}/cmdline", "rb") as f:
                return f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            return "?"

    def stat(p):
        with open(f"/proc/{p}/stat") as f:
            s = f.read()
        return s[s.rfind(")") + 2:].split()

    cmd = cmdline(pid)
    try:
        st = stat(pid)
        if os.path.basename(cmd.split(" ")[0]) in ("cat", "flock", "sh"):
            cmd = f"{cmd} under {cmdline(int(st[1]))}"
        with open("/proc/uptime") as f:
            up = float(f.read().split()[0])
        started = time.time() - up + int(st[19]) / os.sysconf("SC_CLK_TCK")
        return f"pid {pid} ({short(cmd)[:120]}) for {ago(started)}"
    except (OSError, ValueError, IndexError):
        return f"pid {pid} ({short(cmd)[:120]})"


def parent_of(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        return int(s[s.rfind(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        return None


def written_pid(path):
    try:
        with open(path) as f:
            return int(dict(kv.split("=", 1) for kv in f.read().strip().split(" ", 2) if "=" in kv)["pid"])
    except (OSError, ValueError, KeyError):
        return None


def holder_or_locker(path):
    """Who holds `path`. The real holders come from /proc/locks; what a holder wrote into the
    file names it better, and is used when it is one of them (or started one: the test helper
    holds its locks through a small child)."""
    pids = lock_holders(path)
    for f in (path, root_token(path)):
        w = written_pid(f)
        if w and (not pids or w in pids or any(parent_of(p) == w for p in pids)):
            text = holder_text(f)
            if text:
                return text
    return "; ".join(describe_pid(p) for p in pids) if pids else "no details"


def is_busy(path):
    """Whether anyone holds a lock on `path`. Free files are locked for a moment to find out."""
    try:
        fd = open_lock(path)
    except OSError:
        return False
    try:
        return not try_flock(fd)
    finally:
        os.close(fd)


class Pool:
    """A set of tokens, each a flock file, and the gate file a taker holds while it gathers them.

    The machine's pool is /tmp/test-gpu-<n>.lock, n = 1 to TEST_GPU_JOBS (the files the
    party-games test helper takes too), with /tmp/test-gpu-gate.lock as its gate. A token is
    taken while anyone holds any lock on its file: the taker checks it is free with an exclusive
    lock and then holds it shared, so the processes of the job that draw can hold it too (the
    test helper and a gpu-run inside the job take their own shared lock on it). So the token stays
    taken until the last of them is gone, even when gpu-run itself is killed.
    A process whose ancestor holds tokens (TEST_GPU_TOKENS) uses only those: its pool is one
    "<token>.use" file per inherited token, with "<first token>.gate" as the gate, so the processes
    below one job never draw more than the job holds, and what they hold is passed on the same
    way (the files nest: "<token>.use.use" and on). Every lock is a kernel flock on a file this
    process (or a process it started) has open, so it goes away with them, however they end.
    """

    def __init__(self):
        inherited = [p for p in os.environ.get(TOKENS_ENV, "").split(":") if p]
        self.inherited = bool(inherited)
        if inherited:
            self.tokens = [p + ".use" for p in inherited]
            self.gate = inherited[0] + ".gate"
        else:
            self.tokens = [slot_path(n) for n in range(1, card_slots() + 1)]
            self.gate = slot_path("gate")

    def _claim(self, path, label):
        """One token, if free: its open files (the claim, and for a job's own token also the card
        token it stands for, held shared), or None."""
        fd = open_lock(path)
        if not try_flock(fd):
            os.close(fd)
            return None
        if not self.inherited:
            # Free: hold it shared from now on, so the job's processes can share it. Only a
            # taker outside the gate (an older gpu-run or helper) can slip in while the lock
            # changes; then the token is not ours.
            if not try_shared(fd):
                os.close(fd)
                return None
            write_owner(fd, label)
            return [fd]
        write_owner(fd, label)
        fds = [fd]
        keep = open_lock(root_token(path))
        if try_shared(keep):
            fds.append(keep)
        else:  # the card token is no longer held by anyone of the job (all gone): nothing to keep
            os.close(keep)
        return fds

    def _try(self, want, label):
        held = []
        for path in self.tokens:
            fds = self._claim(path, label)
            if fds:
                held.append((path, fds))
                if len(held) == want:
                    return held
        for _, fds in held:
            for fd in fds:
                os.close(fd)
        return None

    def holders(self):
        """One line per busy token: who holds it and for how long."""
        out = []
        for path in self.tokens:
            if is_busy(path):
                out.append(f"{short(path)}: {holder_or_locker(path)}")
        return out

    def take(self, want, label):
        """Waits for `want` tokens (at most all of them) and holds them: all or nothing, so a job
        never sits on some tokens while it waits for others, and two takers never deadlock.

        The gate gives a job that waits for tokens first claim on them, so a job that needs
        several is not starved by single-token jobs that keep slipping in. Its claim is bounded:
        after GATE_PRIORITY_S it lets the gate go for GATE_YIELD_S, so single-token jobs can take
        free tokens beside a long holder, and then queues for the gate again. A gate held longer
        than GATE_WAIT_MAX_S (a holder that hangs) is passed by, with a line naming its holder.
        A job that has waited WAIT_REPORT_S says who holds the tokens, and again every
        WAIT_REPORT_EVERY_S. Returns (the token paths held, their open files, seconds waited)."""
        want = max(1, min(want, len(self.tokens)))
        t0 = time.monotonic()
        said = set()
        report_at = t0 + WAIT_REPORT_S
        gate = None  # the gate's file while this job holds it
        gate_since = gate_wait_from = None
        yield_until = 0.0
        skip_gate = False
        whose = "this job's" if self.inherited else "the card's"

        def say(key, text):
            if key not in said:
                said.add(key)
                print(f"gpu-run: waiting for the graphics card: {text}", file=sys.stderr)

        try:
            while True:
                now = time.monotonic()
                if gate is None and not skip_gate and now >= yield_until:
                    fd = open_lock(self.gate)
                    if try_flock(fd):
                        gate, gate_since, gate_wait_from = fd, now, None
                        write_owner(fd, label)
                    else:
                        os.close(fd)
                        gate_wait_from = gate_wait_from or now
                        waited = now - gate_wait_from
                        if waited > 2:  # a taker holds it only for a moment unless it waits itself
                            say("gate", f"another job is first in line for tokens ({holder_or_locker(self.gate)})")
                        if waited > GATE_WAIT_MAX_S:
                            print(f"gpu-run: the gate {short(self.gate)} has been held for over {GATE_WAIT_MAX_S:g} s "
                                  f"({holder_or_locker(self.gate)}); taking tokens without it", file=sys.stderr)
                            skip_gate = True
                if gate is not None or skip_gate:
                    held = self._try(want, label)
                    if held:
                        return ([p for p, _ in held], [fd for _, fds in held for fd in fds],
                                round(time.monotonic() - t0, 1))
                    say("tokens", f"this job needs {want} of {whose} {len(self.tokens)} tokens "
                                  f"(one per browser drawing at once), and too few are free")
                    if gate is not None and now - gate_since > GATE_PRIORITY_S:
                        os.close(gate)
                        gate, yield_until = None, now + GATE_YIELD_S
                        print(f"gpu-run: still waiting after {GATE_PRIORITY_S:g} s first in line: letting the "
                              f"gate go for {GATE_YIELD_S:g} s, so jobs that need fewer tokens can start", file=sys.stderr)
                if now >= report_at:
                    lines = self.holders()
                    print(f"gpu-run: waited {now - t0:.0f} s for {want} of {whose} tokens; held now: "
                          + ("; ".join(lines) if lines else "none (another job is about to take them)"), file=sys.stderr)
                    report_at = now + WAIT_REPORT_EVERY_S
                time.sleep(0.25)
        finally:
            if gate is not None:
                os.close(gate)


def token_number(path):
    """The pool number of a token of the machine's pool, for the log; None for an inherited one."""
    for n in range(1, card_slots() + 1):
        if slot_path(n) == path:
            return n
    return None


# ---------- running the command ----------

def set_subreaper():
    """Orphaned grandchildren (browser helpers, servers) come back to gpu-run, so their CPU time
    is counted when they are reaped."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        return libc.prctl(36, 1, 0, 0, 0) == 0  # PR_SET_CHILD_SUBREAPER
    except (OSError, AttributeError):
        return False


def children(exclude):
    me, out = str(os.getpid()), []
    for d in os.listdir("/proc"):
        if not d.isdigit() or int(d) in exclude:
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                stat = f.read()
        except OSError:
            continue
        rest = stat[stat.rfind(")") + 2:].split()
        if rest[1] == me and rest[0] != "Z":
            out.append(stat[stat.find("(") + 1:stat.rfind(")")])
    return out


def reap():
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if pid == 0:
            return


def job_tree(exclude):
    """Live processes below gpu-run (the command, what it started, and orphans handed back to
    gpu-run as subreaper), leaving out the processes in exclude and everything below them."""
    parents = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                stat = f.read()
        except OSError:
            continue
        rest = stat[stat.rfind(")") + 2:].split()
        if rest[0] != "Z":
            parents[int(d)] = int(rest[1])
    out, todo = [], [os.getpid()]
    while todo:
        p = todo.pop()
        for c, pp in parents.items():
            if pp == p and c not in exclude:
                out.append(c)
                todo.append(c)
    return out


def stop_job(exclude):
    """SIGTERM to the command and everything it started, SIGKILL to what is left after
    STOP_GRACE seconds. The command keeps gpu-run's process group (so Ctrl-C in the terminal
    still reaches it), so the processes are found through /proc instead of by group."""
    def send(sig):
        for pid in job_tree(exclude):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
    send(signal.SIGTERM)
    deadline = time.monotonic() + STOP_GRACE
    while time.monotonic() < deadline:
        if not job_tree(exclude):
            return
        time.sleep(0.1)
    send(signal.SIGKILL)


class HeatWatch:
    """Reads the samples taken while a job runs; hot() is True once HOT_READINGS readings in a
    row are above the limit. A sample without a temperature breaks the run and is counted."""

    def __init__(self, sampler, first, limit):
        self.sampler, self.next, self.limit = sampler, first, limit
        self.run, self.peak, self.missing = 0, None, 0

    def hot(self):
        samples = self.sampler.samples
        while self.next < len(samples):
            temp = samples[self.next].get("temp")
            self.next += 1
            if temp is None:
                self.missing += 1
                self.run = 0
            elif temp > self.limit:
                self.run += 1
                self.peak = temp if self.peak is None else max(self.peak, temp)
                if self.run >= HOT_READINGS:
                    return True
            else:
                self.run = 0
                self.peak = None
        return False


def events_in_window(rows, start, end):
    """The events whose time falls inside the job's own window (to the second). An event with
    a time that cannot be read does not count."""
    out = []
    for e in rows or []:
        try:
            t = datetime.fromisoformat(str(e.get("time"))).timestamp()
        except (ValueError, TypeError, AttributeError):
            continue
        if int(start) <= t <= int(end) + 1:
            out.append(e)
    return out


def switch_off_for(event, label):
    """Writes the OFF marker for a driver event during a job, unless the card is already off.
    Returns True when it wrote the marker."""
    if os.path.exists(OFF):
        return False
    with open(OFF, "w") as f:
        f.write(f"{now_iso()} driver event during the job \"{label}\": "
                f"{event.get('provider')} {event.get('id')} at {event.get('time')}\n")
    return True


def admission(sampler, max_wait):
    """Waits until the card looks able to take a job: the busiest engine averaged under
    ADMIT_MAX_LOAD over the last ADMIT_WINDOW_S, at least ADMIT_MIN_FREE_GB of video memory free,
    the card under ADMIT_MAX_TEMP, and no display driver event in the last ADMIT_EVENT_MINUTES.
    Says why in one line whenever the reasons change (and once a minute while they do not).
    Returns None once admitted, or the reasons still standing after max_wait seconds.

    A figure that cannot be read does not hold a job back (an older driver gives no temperature,
    and a broken sampler would otherwise stop every job); it is said once instead. The other
    safeties still apply: --max-temp, the OFF switch, and the switch-off after a driver event.
    """
    need = max(1, math.ceil(ADMIT_WINDOW_S / INTERVAL))  # load readings that span the window
    t0 = time.monotonic()
    fill_limit = t0 + ADMIT_WINDOW_S * 3 + 30
    events_at, event, said, said_at, notes = None, None, None, 0.0, set()

    def note(text):
        if text not in notes:
            notes.add(text)
            print(f"gpu-run: admission: {text}", file=sys.stderr)

    while True:
        # Another sampler's readings over the whole window when there are some, else this job's
        # own, which take about ADMIT_WINDOW_S to gather.
        shared = shared_readings(time.time())
        if shared:
            window, total = shared
            loads = [s["load"] for s in window if s.get("load") is not None]
            used = window[-1].get("used")
            temp = next((s["temp"] for s in reversed(window) if s.get("temp") is not None), None)
        else:
            loads = [s["load"] for s in sampler.samples if s.get("load") is not None][-need:]
            if len(loads) < need:
                done = sampler.proc is None or sampler.proc.poll() is not None
                if done or time.monotonic() > fill_limit:
                    note(f"not checked ({sampler.error or 'the sampler gave too few readings'}); the job goes ahead")
                    return None
                time.sleep(0.2)
                continue
            total, used = sampler.samples[0].get("total"), sampler.samples[-1].get("used")
            temp = sampler.latest_temp()
        reasons = {}
        avg = statistics.fmean(loads)
        if avg >= ADMIT_MAX_LOAD:
            reasons["load"] = f"the card's load averaged {avg:.0f}% over the last {ADMIT_WINDOW_S} s (wanted under {ADMIT_MAX_LOAD:g}%)"
        if total and used is not None:
            free = (total - used) / GB
            if free < ADMIT_MIN_FREE_GB:
                reasons["memory"] = f"{free:.1f} GB of video memory free (wanted at least {ADMIT_MIN_FREE_GB:g} GB)"
        else:
            note("free video memory not known")
        if temp is None:
            note("the card's temperature not known")
        elif temp >= ADMIT_MAX_TEMP:
            reasons["heat"] = f"the card is at {temp:g} C (wanted under {ADMIT_MAX_TEMP:g} C)"
        if events_at is None or time.monotonic() - events_at >= ADMIT_EVENT_RECHECK_S:
            checked, event = recent_driver_event(time.time())
            events_at = time.monotonic()
            if not checked:
                note("the display driver events could not be checked")
        if event:
            at, e = event
            back = datetime.fromtimestamp(at + ADMIT_EVENT_MINUTES * 60).strftime("%H:%M")
            reasons["event"] = (f"a display driver event at {datetime.fromtimestamp(at).strftime('%H:%M')} "
                                f"({e.get('provider')} {e.get('id')}); the card takes jobs again from about {back}")
        waited = time.monotonic() - t0
        if not reasons:
            if said:
                print(f"gpu-run: the card has settled after {waited:.0f} s; going ahead", file=sys.stderr)
            return None
        text = "; ".join(reasons.values())
        if waited >= max_wait:
            return text
        if said != tuple(reasons) or time.monotonic() - said_at >= 60:
            print(f"gpu-run: waiting for the card to settle: {text} (gives up after {max_wait:g} s)", file=sys.stderr)
            said, said_at = tuple(reasons), time.monotonic()
        time.sleep(min(INTERVAL, max(0.1, max_wait - waited)))


def shared_readings(now):
    """Readings over the last ADMIT_WINDOW_S from another job's sampler that has run for that whole
    window and is still reading: (the readings, the card's total video memory), or None. A
    sampler that started later than that does not count (too few readings to average)."""
    best = None
    try:
        names = os.listdir(LIVE)
    except OSError:
        return None
    for name in names:
        if not name.endswith(".json") or name == f"{os.getpid()}.json":
            continue
        path = os.path.join(LIVE, name)
        try:
            if os.stat(path).st_mtime < now - 3600:  # an old job's: tidy up
                os.unlink(path)
                continue
            with open(path) as f:
                d = json.load(f)
            samples, since, total = d["samples"], d["since"], d.get("total")
            # A file that is not what a sampler writes is skipped whole, never trusted in part.
            if not (isinstance(samples, list) and finite(since) and (total is None or finite(total))):
                continue
            if not all(isinstance(s, dict) and finite(s.get("at"))
                       and all(s.get(k) is None or finite(s.get(k)) for k in ("load", "used", "temp"))
                       for s in samples):
                continue
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
        # Readings dated ahead of this machine's clock (a clock step) do not count.
        samples = [s for s in samples if s["at"] <= now + LIVE_FUTURE_SLACK_S]
        if not samples or since > now - ADMIT_WINDOW_S or samples[-1]["at"] < now - (2 * INTERVAL + 1):
            continue
        window = [s for s in samples if s["at"] >= now - ADMIT_WINDOW_S]
        if any(s.get("load") is not None for s in window) and (best is None or samples[-1]["at"] > best[2]):
            best = (window, total, samples[-1]["at"])
    return best[:2] if best else None


def finite(x):
    """A real number (not a bool, not NaN or infinity)."""
    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)


def recent_driver_event(now):
    """(whether the log could be read, the newest counted display driver event within the last
    ADMIT_EVENT_MINUTES as (its time, the event) or None).

    Windows files a driver timeout's report more than once: first plain, then processed (with a
    fault bucket, "LKD_...") up to about half an hour later. A processed report that follows an
    earlier report within ADMIT_EVENT_REPORT_LAG_MINUTES is that event again, so it does not
    restart the window; the first report's time counts."""
    look = (ADMIT_EVENT_MINUTES + ADMIT_EVENT_REPORT_LAG_MINUTES) * 60
    rows = driver_events(now - look, now)
    if rows is None:
        return False, None
    timed = []
    for e in rows:
        try:
            timed.append((datetime.fromisoformat(str(e.get("time"))).timestamp(), e))
        except (ValueError, TypeError, AttributeError):
            continue
    timed.sort(key=lambda te: te[0])
    counted = []
    for i, (t, e) in enumerate(timed):
        processed = "Fault bucket LKD_" in str(e.get("text"))
        if processed and any(t - ADMIT_EVENT_REPORT_LAG_MINUTES * 60 <= t2 < t for t2, _ in timed[:i]):
            continue
        counted.append((t, e))
    recent = [te for te in counted if te[0] >= now - ADMIT_EVENT_MINUTES * 60]
    return True, (recent[-1] if recent else None)


def write_refused(args, command, sampler, why, admit_wait):
    """Logs a job that admission turned away (exit 6), with what the card looked like."""
    sampler.stop()
    now = time.time()
    rec = {
        "v": 1, "start": now_iso(now - admit_wait), "end": now_iso(now), "label": args.label, "kind": args.kind,
        "cpu_run": False, "lock": "none", "tokens": 0, "slots": [], "lock_wait_s": 0.0, "admit_wait_s": admit_wait,
        "refused": why, "cmd": short(shlex.join(command)), "cwd": short(os.getcwd()), "exit": 6, "wall_s": 0.0,
        "cpu_s": None, "avg_cores": None, "loadavg_start": loadavg(), "loadavg_end": loadavg(),
        "gpu": sampler.summary(), "driver_events": None,
    }
    with open(LOG, "a") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")


def run_job(args, command):
    cpu_run = args.cpu
    if not cpu_run:
        why = off_reason()
        if why:
            print(f"gpu-run: not started: {why}", file=sys.stderr)
            return 3
    os.makedirs(STATE, exist_ok=True)
    reaper = set_subreaper()
    sampler = Sampler(max_seconds=7 * 24 * 3600)
    sampler.wait_ready()
    if args.max_temp is not None:
        temp = sampler.latest_temp()
        why = ("the card's temperature could not be read" if temp is None
               else f"the card is at {temp:g} C (wanted at most {args.max_temp:g} C)" if temp > args.max_temp else None)
        if why:
            sampler.stop()
            print(f"gpu-run: not started: {why}", file=sys.stderr)
            return 5
    tokens, lock_fds, lock_wait, pool = [], [], 0.0, None
    if not (args.no_lock or cpu_run):
        pool = Pool()
        want = len(pool.tokens) if args.kind in HEAVY else args.tokens
        if args.tokens > len(pool.tokens) and args.kind not in HEAVY:
            print(f"gpu-run: --tokens {args.tokens} is more than the {len(pool.tokens)} there are; taking all of them", file=sys.stderr)
    # Admission comes before the tokens, so no token sits idle while a job waits for the card to
    # settle. A job inside an admitted job is part of it, and a --cpu run does not use the card.
    check = not cpu_run and not (pool and pool.inherited)
    admit_wait, forced = 0.0, None
    while True:
        if check:
            t_admit = time.monotonic()
            # One allowance across every round: a card that keeps getting busy while the job
            # waits for tokens still ends in exit 6 (or the start anyway) after --admit-wait.
            why = admission(sampler, max(0.0, args.admit_wait - admit_wait))
            admit_wait = round(admit_wait + time.monotonic() - t_admit, 1)
            if why and not args.admit_timeout_runs:
                print(f"gpu-run: not started: the card did not settle within {args.admit_wait:g} s: {why}", file=sys.stderr)
                write_refused(args, command, sampler, why, admit_wait)
                return 6
            if why:
                forced = why
                print(f"gpu-run: STARTING ANYWAY (--admit-timeout-runs): the card did not settle within "
                      f"{args.admit_wait:g} s: {why}", file=sys.stderr)
        if pool:
            tokens, lock_fds, lock_wait = pool.take(want, args.label)
        if check and not forced and lock_wait > ADMIT_WINDOW_S:
            # A long wait for tokens: look at the card again (the readings are already there).
            why = admission(sampler, 0)
            if why:
                print(f"gpu-run: the card got busy while this job waited for its tokens ({why}); "
                      f"letting them go and waiting for it to settle", file=sys.stderr)
                for fd in lock_fds:
                    os.close(fd)
                tokens, lock_fds = [], []
                continue
        break
    if args.only_when_idle is not None:  # checked after the waits, right before starting
        why = not_idle_reason(args.only_when_idle)
        if why:
            sampler.stop()
            print(f"gpu-run: not started: {why}", file=sys.stderr)
            return 4
    env = dict(os.environ)
    if cpu_run:
        env["TEST_NO_GPU"] = "1"
    if tokens:
        # The command and everything it starts draw only on the tokens this job holds: the
        # party-games test helper (lobby/test/browser.mjs) and a gpu-run inside this one claim one
        # of these instead of taking from the pool.
        env[TOKENS_ENV] = ":".join(tokens)
        if not pool.inherited:
            # For a test helper from before the token pool, which does not read TEST_GPU_TOKENS
            # and takes /tmp/test-gpu-<n>.lock itself, n = 1..TEST_GPU_JOBS: one more file than
            # the pool, so it never waits on its own parent's tokens, and no queueing for it
            # (TEST_GPU_SLOT_HELD). The helper with the token pool ignores both when
            # TEST_GPU_TOKENS is set. Drop these once no checkout has the old helper.
            env["TEST_GPU_JOBS"] = str(card_slots() + 1)
            env["TEST_GPU_SLOT_HELD"] = "1"
    first = len(sampler.samples)
    load0 = loadavg()
    ru0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    t0, start = time.monotonic(), time.time()
    try:
        # The token locks are not passed to the command: whatever it leaves running (a dev server
        # started with &, a Worker) would hold them for its whole life after the job. What draws
        # keeps its token by itself: the party-games test helper and a gpu-run inside this job
        # hold the card token shared for as long as they run (Pool._claim, claim in
        # lobby/test/browser.mjs), even if this gpu-run is killed. A command that draws without
        # either (Blender, another repo's runner) is covered while gpu-run lives, which is to its
        # end unless gpu-run itself is killed outright.
        proc = subprocess.Popen(command, env=env)
    except OSError as e:
        print(f"gpu-run: cannot run {command[0]}: {e}", file=sys.stderr)
        sampler.stop()
        return 127
    signal.signal(signal.SIGINT, lambda *_: None)  # Ctrl-C reaches the command; we stay to log
    signal.signal(signal.SIGTERM, lambda *_: proc.terminate())
    keep = {sampler.proc.pid} if sampler.proc else set()
    heat = HeatWatch(sampler, first, args.max_temp) if args.max_temp is not None else None
    stopped = False
    while True:
        try:
            rc = proc.wait(timeout=0.5 if heat else None)
            break
        except subprocess.TimeoutExpired:
            if not stopped and heat.hot():
                stopped, stop_peak = True, heat.peak
                print(f"gpu-run: stopping the job: the card stayed above {args.max_temp:g} C for "
                      f"{HOT_READINGS} readings (peak {heat.peak:g} C)", file=sys.stderr)
                stop_job(keep)
    wall = time.monotonic() - t0
    end = time.time()
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    for _ in range(20):  # helpers often exit a moment after the command
        if not children(keep):
            break
        time.sleep(0.1)
    # Reap after the last look, not before it: a helper that exited between a reap and the look
    # was a zombie the look skips, so it was never reaped and its CPU time was missing from the
    # usage read below (the orphaned-grandchild test failed about one run in ten under load).
    # Every helper the looks saw finish is a zombie by now, so this one reap collects them all.
    reap()
    left = children(keep)
    ru1 = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu = (ru1.ru_utime - ru0.ru_utime) + (ru1.ru_stime - ru0.ru_stime)
    sampler.stop()
    for fd in lock_fds:
        os.close(fd)
    # Something the command left running that still holds one of this job's tokens (a test
    # helper or a gpu-run started in the background) keeps it taken, since it can still draw:
    # say so loudly, name it, and log it.
    left_holding = []
    if tokens:
        mine = set(job_tree(keep))
        for path in dict.fromkeys(tokens + [root_token(t) for t in tokens]):
            for pid in lock_holders(path):
                if pid in mine:
                    left_holding.append({"pid": pid, "token": short(path), "what": describe_pid(pid)})
        for h in left_holding:
            print(f"gpu-run: LEFT RUNNING AND HOLDING A CARD TOKEN: {h['what']} holds {h['token']}; "
                  f"it counts against the card's tokens until it ends", file=sys.stderr)
    rec = {
        "v": 1,
        "start": now_iso(start),
        "end": now_iso(end),
        "label": args.label,
        "kind": args.kind,
        "cpu_run": cpu_run,
        "lock": ("inherited" if pool.inherited else "held") if tokens else "none",
        "tokens": len(tokens),
        "slots": [n for n in map(token_number, tokens) if n is not None],
        "lock_wait_s": lock_wait,
        "admit_wait_s": admit_wait,
        **({"admit_timed_out": forced} if forced else {}),
        "cmd": short(shlex.join(command)),
        "cwd": short(os.getcwd()),
        "exit": rc if rc >= 0 else 128 - rc,
        "wall_s": round(wall, 2),
        "cpu_s": round(cpu, 2),
        "avg_cores": round(cpu / wall, 2) if wall > 0 else None,
        "cpu_complete": reaper and not left,
        "left_running": left,
        **({"left_holding": left_holding} if left_holding else {}),
        "loadavg_start": load0,
        "loadavg_end": loadavg(),
        "gpu": sampler.summary(first),
        "driver_events": driver_events(start, end),
    }
    if heat:
        if not stopped:
            heat.hot()  # count the readings that came in after the last check
        rec["max_temp_c"] = args.max_temp
        rec["stopped_for_heat"] = stopped
        if stopped:
            rec["heat_peak_c"] = stop_peak
        if heat.missing:
            rec["temp_readings_missing"] = heat.missing
    write_record(rec)
    fresh = events_in_window(rec["driver_events"], start, end)
    if fresh and switch_off_for(fresh[0], args.label):
        e = fresh[0]
        print(f"gpu-run: switched the card off for GPU jobs: {e.get('provider')} {e.get('id')} at {e.get('time')} "
              f"happened during this job; `gpu-run --on` switches it back on", file=sys.stderr)
    return 5 if stopped else rec["exit"]


def run_watch(args):
    os.makedirs(STATE, exist_ok=True)
    seconds = args.watch
    sampler = Sampler(max_seconds=seconds + 60)
    sampler.wait_ready()
    first = len(sampler.samples)
    load0, start = loadavg(), time.time()
    deadline = time.monotonic() + seconds
    try:
        while time.monotonic() < deadline and (not sampler.proc or sampler.proc.poll() is None):
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    end = time.time()
    sampler.stop()
    rec = {
        "v": 1, "start": now_iso(start), "end": now_iso(end), "label": args.label or "desktop baseline",
        "kind": "watch", "cpu_run": False, "lock": "none", "lock_wait_s": 0.0, "cmd": None,
        "cwd": short(os.getcwd()), "exit": 0, "wall_s": round(end - start, 2), "cpu_s": None,
        "avg_cores": None, "loadavg_start": load0, "loadavg_end": loadavg(),
        "gpu": sampler.summary(first, trace=True), "driver_events": driver_events(start, end),
    }
    write_record(rec)
    return 0


def write_record(rec):
    with open(LOG, "a") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")
    g = rec["gpu"]
    cpu = "" if rec["cpu_s"] is None else f", CPU {rec['cpu_s']} s ({rec['avg_cores']} cores)"
    mode = " on the CPU" if rec["cpu_run"] else ""
    load = rec["loadavg_start"][0] if rec["loadavg_start"] else "?"
    print(f"gpu-run: {rec['label']} ({rec['kind']}{mode}) exit {rec['exit']} in {rec['wall_s']} s{cpu}, load average {load}")
    if "error" in g and not g.get("adapter"):
        print(f"card: not sampled ({g['error']})")
    else:
        if g.get("load_peak") is None:
            load = "load not measured (shorter than one sample)"
        else:
            busiest = next((k for k in g.get("engines_peak") or {} if "video" not in k), None)
            load = f"load peak {g['load_peak']}% avg {g['load_avg']}%" + (f" (busiest engine: {busiest})" if busiest else "")
        heat = ""
        if g.get("temp_c_peak") is not None:
            heat = f", {g['temp_c_start']:g} C at the start, peak {g['temp_c_peak']:g} C"
            if g.get("fan_rpm_peak") is not None:
                heat += f", fan peak {g['fan_rpm_peak']} rpm"
        print(f"card: {g['adapter']} {load}, "
              f"memory peak {g['vram_used_peak_gb']} of {g['vram_total_gb']} GB ({g['vram_free_before_gb']} GB free before){heat}, {g['samples']} samples")
    ev = rec["driver_events"]
    if ev is None:
        print(f"driver events: not checked; logged to {short(LOG)}")
    elif not ev:
        print(f"driver events: none; logged to {short(LOG)}")
    else:
        first = ev[0]
        print(f"DRIVER EVENTS: {len(ev)} ({first['provider']} {first['id']} at {first['time']}); logged to {short(LOG)}")


# ---------- report ----------

def parse_since(text):
    try:
        return datetime.fromisoformat(text).astimezone()
    except ValueError:
        sys.exit(f"gpu-run: --since wants a date like 2026-11-15, not {text!r}")


def read_log(since):
    rows = []
    try:
        with open(LOG) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if since and datetime.fromisoformat(r["start"]) < since:
                    continue
                rows.append(r)
    except FileNotFoundError:
        pass
    return rows


def fmt(x, unit=""):
    return "-" if x is None else f"{x:g}{unit}" if isinstance(x, (int, float)) else str(x)


def med(x):
    return f"{round(x, 1):g}"


def report(since):
    rows = read_log(since)
    out = [f"# GPU jobs{' since ' + since.date().isoformat() if since else ''}", ""]
    if not rows:
        out.append("No jobs logged.")
        return "\n".join(out)
    out += [f"{len(rows)} records, {rows[0]['start']} to {rows[-1]['end']}.", ""]
    out += ["## By kind", "",
            "| Kind | Runs | Failed | Median wall | Worst wall | Peak card load | Peak video memory | Peak temperature |",
            "|---|---|---|---|---|---|---|---|"]
    kinds = {}
    for r in rows:
        if r.get("refused"):
            continue
        kinds.setdefault(r["kind"] + (" (CPU)" if r.get("cpu_run") else ""), []).append(r)
    for k, rs in sorted(kinds.items()):
        walls = [r["wall_s"] for r in rs]
        loads = [r["gpu"].get("load_peak") for r in rs if r["gpu"].get("load_peak") is not None]
        vram = [r["gpu"].get("vram_used_peak_gb") for r in rs if r["gpu"].get("vram_used_peak_gb") is not None]
        temps = [r["gpu"].get("temp_c_peak") for r in rs if r["gpu"].get("temp_c_peak") is not None]
        out.append(f"| {k} | {len(rs)} | {sum(1 for r in rs if r['exit'])} | {med(statistics.median(walls))} s | {max(walls):g} s | "
                   f"{fmt(max(loads) if loads else None, '%')} | {fmt(max(vram) if vram else None, ' GB')} | {fmt(max(temps) if temps else None, ' C')} |")
    pairs = []
    labels = {}
    for r in rows:
        if r["kind"] != "watch" and r["exit"] == 0:
            labels.setdefault(r["label"], {"card": [], "cpu": []})["cpu" if r.get("cpu_run") else "card"].append(r)
    for label, d in labels.items():
        if d["card"] and d["cpu"]:
            cw = statistics.median(r["wall_s"] for r in d["card"])
            pw = statistics.median(r["wall_s"] for r in d["cpu"])
            cc = [r["cpu_s"] for r in d["card"] if r["cpu_s"] is not None]
            pc = [r["cpu_s"] for r in d["cpu"] if r["cpu_s"] is not None]
            cc, pc = (statistics.median(cc) if cc else None), (statistics.median(pc) if pc else None)
            saved = f"{pc / cc:.1f}x" if cc and pc else "-"
            pairs.append(f"| {label} | {len(d['card'])} / {len(d['cpu'])} | {med(cw)} s | {med(pw)} s | {pw / cw:.1f}x | "
                         f"{fmt(cc and round(cc, 1), ' s')} | {fmt(pc and round(pc, 1), ' s')} | {saved} |")
    out += ["", "## Card against CPU (same label, passing runs, medians)", ""]
    if pairs:
        out += ["| Label | Runs card / CPU | Wall on card | Wall on CPU | Wall speed-up | CPU time on card | CPU time on CPU | CPU saved |",
                "|---|---|---|---|---|---|---|---|"] + pairs
    else:
        out.append("No label has both a card run and a `--cpu` run yet.")
    refused = [r for r in rows if r.get("refused")]
    if refused:
        out += ["", "## Turned away at admission (exit 6)", ""]
        out += [f"- {r['start']} {r['label']} ({r['kind']}) after {r.get('admit_wait_s', 0):g} s: {r['refused']}" for r in refused]
    hit = [r for r in rows if r.get("driver_events")]
    out += ["", "## Jobs during a driver event", ""]
    if hit:
        for r in hit:
            for e in r["driver_events"]:
                out.append(f"- {r['start']} {r['label']} ({r['kind']}, exit {r['exit']}): {e['provider']} {e['id']} at {e['time']}: {e['text']}")
    else:
        unchecked = sum(1 for r in rows if r.get("driver_events") is None)
        out.append("None." + (f" ({unchecked} records could not check the event log.)" if unchecked else ""))
    watches = [r for r in rows if r["kind"] == "watch"]
    if watches:
        out += ["", "## Baselines (--watch)", "",
                "| Start | Label | Seconds | Card load avg / peak | Video memory in use | Temperature start / peak / end | Top users |",
                "|---|---|---|---|---|---|---|"]
        for r in watches:
            g = r["gpu"]
            top = ", ".join(f"{n} {b} GB" for n, b in g.get("top_vram_gb", [])[:3])
            heat = (f"{fmt(g['temp_c_start'])} / {fmt(g['temp_c_peak'])} / {fmt(g.get('temp_c_end'))} C"
                    if g.get("temp_c_peak") is not None else "-")
            out.append(f"| {r['start']} | {r['label']} | {r['wall_s']:g} | {fmt(g.get('load_avg'), '%')} / {fmt(g.get('load_peak'), '%')} | "
                       f"{fmt(g.get('vram_used_peak_gb'), ' GB')} of {fmt(g.get('vram_total_gb'), ' GB')} | {heat} | {top} |")
    return "\n".join(out)


def events(since):
    start = (since or datetime.now().astimezone() - timedelta(days=7)).timestamp()
    rows = driver_events(start, time.time())
    if rows is None:
        print("gpu-run: could not query the Windows event logs")
        return 1
    if not rows:
        print("No display driver events.")
    for e in rows:
        print(f"{e['time']}  {e['log']}/{e['provider']} {e['id']}: {e['text']}")
    return 0


# ---------- main ----------

def main(argv):
    command = []
    if "--" in argv:
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="gpu-run", description="Run a command as a graphics-card job and log what happened.")
    ap.add_argument("--label", help="what this job is; the same label on a --cpu run makes a comparison")
    ap.add_argument("--kind", choices=KINDS, default="other")
    ap.add_argument("--cpu", action="store_true", help="a CPU comparison run: no lock, TEST_NO_GPU=1 for the command")
    ap.add_argument("--no-lock", action="store_true", help="do not take the shared card lock")
    ap.add_argument("--tokens", type=int, default=1, metavar="N",
                    help="card tokens this job holds: how many browsers it may have drawing at once (default 1; "
                         "--kind blender, image and model take them all)")
    ap.add_argument("--admit-wait", type=float, default=ADMIT_MAX_WAIT_S, metavar="SECONDS",
                    help=f"how long to wait for a busy, full, hot or recently crashed card to settle before failing "
                         f"(exit 6; default {ADMIT_MAX_WAIT_S}, 0 checks once)")
    ap.add_argument("--admit-timeout-runs", action="store_true",
                    help="after --admit-wait, start anyway with a loud line instead of failing (for the pre-deploy "
                         "gate, which must not fail because the card was busy)")
    ap.add_argument("--only-when-idle", type=float, metavar="MINUTES",
                    help="refuse (exit 4) unless the owner has not touched the PC for MINUTES and nothing runs full screen")
    ap.add_argument("--max-temp", type=float, metavar="C",
                    help="refuse (exit 5) while the card is hotter than C degrees, or its temperature cannot be read, "
                         "and stop the job (exit 5) after three readings in a row above C")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--watch", type=float, metavar="SECONDS", help="sample the card without running a command")
    mode.add_argument("--report", action="store_true", help="print a Markdown report of the log")
    mode.add_argument("--events", action="store_true", help="list display driver events (default: last 7 days)")
    mode.add_argument("--off", metavar="REASON", help="switch GPU jobs off everywhere")
    mode.add_argument("--on", action="store_true", help="switch GPU jobs back on")
    ap.add_argument("--since", help="with --report or --events: from this date (YYYY-MM-DD)")
    args = ap.parse_args(argv)
    if args.max_temp is not None and not (0 < args.max_temp <= MAX_TEMP_LIMIT):  # also catches nan
        ap.error(f"--max-temp wants degrees C above 0 and at most {MAX_TEMP_LIMIT}, not {args.max_temp:g}")
    if args.tokens < 1:
        ap.error(f"--tokens wants 1 or more, not {args.tokens}")
    if not (0 <= args.admit_wait < math.inf):  # also catches nan
        ap.error(f"--admit-wait wants seconds, 0 or more, not {args.admit_wait:g}")
    since = parse_since(args.since) if args.since else None
    if args.report:
        print(report(since))
        return 0
    if args.events:
        return events(since)
    if args.off is not None:
        os.makedirs(STATE, exist_ok=True)
        with open(OFF, "w") as f:
            f.write(f"{now_iso()} {args.off}\n")
        print(f"gpu-run: the card is switched off for GPU jobs ({args.off}); `gpu-run --on` switches it back on")
        return 0
    if args.on:
        try:
            os.unlink(OFF)
            print("gpu-run: the card is switched on for GPU jobs")
        except FileNotFoundError:
            print("gpu-run: the card was already on")
        return 0
    if args.watch is not None:
        if command:
            ap.error("--watch takes no command")
        if args.watch <= 0:
            ap.error("--watch wants a number of seconds above 0")
        return run_watch(args)
    if not command:
        ap.error("give a command after --, or one of --watch, --report, --events, --off, --on")
    if not args.label:
        ap.error("--label is required for a job")
    return run_job(args, command)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
