  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.local/bin/dcg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.claude/hooks/confirm-destructive-git.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/normalize-agents-md.sh 2>/dev/null || true",
            "statusMessage": "Normalizing AGENTS.md/CLAUDE.md symlink"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.local/bin/agent-lock hook claude-session-start",
            "statusMessage": "Checking agent config"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.local/bin/agent-lock hook claude-config-change"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/normalize-agents-md.sh 2>/dev/null || true",
            "statusMessage": "Normalizing AGENTS.md/CLAUDE.md symlink"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/commit-reminder.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
