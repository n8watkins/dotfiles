{
  "permissions": {
    "allow": [
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(npx wrangler secret put:*)",
      "Bash(bash scripts/deploy-app.sh:*)",
      "Bash(npx opennextjs-cloudflare deploy)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler d1 migrations list:*)",
      "Bash(npx wrangler deployments list:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)"
    ],
    "ask": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh secret remove:*)",
      "Bash(gh auth refresh:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pass-env generate * --force*)",
      "Bash(pass-env import * --remove*)",
      "Bash(pass-env scrub *--fix*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.env)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(~/.password-store/**)",
      "Read(~/.feelium-deploy.env)",
      "Read(~/.gnupg/**)",
      "Bash(pass)",
      "Bash(pass *)",
      "Bash(gpg -d *)",
      "Bash(gpg --decrypt *)",
      "Bash(pass-env copy *)",
      "Bash(pass-env run *-- env*)",
      "Bash(pass-env run *-- printenv*)",
      "Bash(pass-env run *-- echo *)",
      "Bash(pass-env run *-- printf *)",
      "Bash(pass-env run *-- sh *)",
      "Bash(pass-env run *-- bash *)",
      "Bash(pass-env run *-- zsh *)",
      "Bash(pass-env run *-- node -e*)",
      "Bash(pass-env run *-- node -p*)",
      "Bash(pass-env run *-- python* -c*)",
      "Bash(pass-env pipe *-- cat*)",
      "Bash(pass-env pipe *-- tee*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.claude/hooks/confirm-destructive-git.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/normalize-agents-md.sh 2>/dev/null || true",
            "statusMessage": "Normalizing AGENTS.md/CLAUDE.md symlink"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/normalize-agents-md.sh 2>/dev/null || true",
            "statusMessage": "Normalizing AGENTS.md/CLAUDE.md symlink"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/natkins/.config/agent-hooks/commit-reminder.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
